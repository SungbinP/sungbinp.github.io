@unpublished{park2026forced,
  title={Forced to Choose? Unemployment Insurance and the Medicaid Notch},
  author={Park, Sungbin},
  abstract={Medicaid eligibility rules may force some workers to choose between unemployment insurance (UI) benefits and health insurance coverage. Because Medicaid eligibility is based on income including UI benefits, some workers face a notch in loss of coverage if they claim UI. Exploiting the changing Medicaid eligibility of childless adults due to ACA expansions, I focus on the ``notched'' group and analyze UI take-up using the 2008--2018 Survey of Income and Program Participation. I find UI take-up falls by 19.6 percentage points among notched workers, 27 percent of their pre-expansion rate, while the comparison group, whose UI benefits do not increase income above the Medicaid eligibility threshold, shows no significant decline in UI take-up. The effect is stronger for workers whose predicted health care needs are higher. Removal of the notch produces symmetric effects. I estimate that 98,000 workers per year face the forced choice, that the average willingness to pay for Medicaid is at least &#36;5,900 per unemployment spell, and that eliminating the notch would add about &#36;104 million in UI spending and &#36;171 million in Medicaid spending.},
  year={2026},
  note={Job Market Paper},
  pdf={Park_JMP_UI_Medicaid_Notch.pdf}
}
